# The customer-facing web server: the built React app, plus HTTPS and the
# reverse proxy to the API. Built from the repository root so it can see
# both frontend/ and deploy/.

# ---------------------------------------------------------------- build
FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Belt and braces. .dockerignore should already have kept every .env out of
# the build context, but Vite bakes VITE_* values into the JavaScript it
# ships to browsers, so a mistake here is a mistake a customer can read.
# Delete any that got through, and prove none survived.
RUN rm -f .env .env.* && ls -a | grep -qx '.env' && exit 1 || true

RUN npm run build

# ----------------------------------------------------------------- serve
FROM caddy:2-alpine

COPY --from=build /app/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443
