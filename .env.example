# Template for .env — copy to .env and replace the placeholder values.
#   cp .env.example .env

POSTGRES_DB=alok_portal
POSTGRES_USER=alok_portal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Connection string used by the backend (host machine -> docker published port)
DATABASE_URL=postgresql+psycopg2://alok_portal:change-me@localhost:5432/alok_portal

# Temporary demo login account (replaced by real customer accounts in Step 2)
DEMO_LOGIN_EMAIL=demo@example.com
DEMO_LOGIN_PASSWORD=change-me

# Signs the login tokens. Keep secret. Changing it signs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-long-random-value-at-least-32-characters
TOKEN_TTL_SECONDS=43200

# Demo customer seeded by seed.py (development only)
DEMO_CUSTOMER_CODE=CUST-001
DEMO_CUSTOMER_NAME=Demo Customer GmbH
DEMO_CUSTOMER_COUNTRY=Germany

# Second demo customer, used to prove one customer cannot see another's orders
DEMO2_CUSTOMER_CODE=CUST-002
DEMO2_CUSTOMER_NAME=Second Demo Customer Ltd
DEMO2_CUSTOMER_COUNTRY=Italy
DEMO2_LOGIN_EMAIL=buyer@second-demo.example
DEMO2_LOGIN_PASSWORD=change-me

# Where uploaded customer documents are kept on the server.
# Leave blank to use <project>/storage/documents. Never inside the repo.
DOCUMENT_STORAGE_DIR=

# Live vessel tracking. {imo} is replaced with the ship's IMO number.
# Swap these two lines to move to a paid carrier tracking service later.
TRACKING_URL_TEMPLATE=https://www.marinetraffic.com/en/ais/details/ships/imo:{imo}
TRACKING_PROVIDER_NAME=MarineTraffic

# ---- Notifications -------------------------------------------------------
# Master switch. Leave false until you are certain; nothing is emailed while
# it is off, but every message is still recorded and printed.
SEND_EMAILS=false

# During a pilot, ONLY these addresses receive real mail (comma separated).
# Leave blank to mail every customer.
NOTIFY_ONLY_EMAILS=

# Which shipment statuses are worth telling a customer about.
NOTIFY_ON_STATUSES=Shipped,In transit,Delivered

# Outgoing mail server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=portal@alokindia.co.in

# Where the portal lives, used in the email link
PORTAL_URL=https://portal.alokindia.co.in
