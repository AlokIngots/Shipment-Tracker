# Template for .env — copy to .env and replace the placeholder values.
#   cp .env.example .env

POSTGRES_DB=alok_portal
POSTGRES_USER=alok_portal
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Connection string used by the backend (host machine -> docker published port)
DATABASE_URL=postgresql+psycopg2://alok_portal:change-me@localhost:5432/alok_portal

# Temporary demo login account (replaced by real customer accounts in Step 2)
DEMO_LOGIN_EMAIL=demo@example.com
DEMO_LOGIN_PASSWORD=change-me

# Signs the login tokens. Keep secret. Changing it signs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-long-random-value-at-least-32-characters
# How many days somebody stays signed in, even after closing the browser.
# Sign out ends it at once. (Replaces TOKEN_TTL_SECONDS, which is ignored.)
SESSION_TTL_DAYS=30

# Demo customer seeded by seed.py (development only)
DEMO_CUSTOMER_CODE=CUST-001
DEMO_CUSTOMER_NAME=Demo Customer GmbH
DEMO_CUSTOMER_COUNTRY=Germany

# Second demo customer, used to prove one customer cannot see another's orders
DEMO2_CUSTOMER_CODE=CUST-002
DEMO2_CUSTOMER_NAME=Second Demo Customer Ltd
DEMO2_CUSTOMER_COUNTRY=Italy
DEMO2_LOGIN_EMAIL=buyer@second-demo.example
DEMO2_LOGIN_PASSWORD=change-me

# Where uploaded customer documents are kept on the server.
# Leave blank to use <project>/storage/documents. Never inside the repo.
DOCUMENT_STORAGE_DIR=

# There is no vessel tracking setting any more. A link to a named ship's
# live position, and briefly a map of it, were both removed on 15 Sep 2026:
# transshipped cargo changes vessel, so the first ship sails on to another
# voyage while the boxes wait at a hub, and its position is a different trip.
# TRACKING_URL_TEMPLATE, TRACKING_PROVIDER_NAME, VESSEL_MAP_URL_TEMPLATE and
# VESSEL_MAP_PROVIDER_NAME are no longer read. Left in a server's .env they
# do nothing at all, so there is no hurry to take them out.

# Tracking the box rather than the ship is the carrier's own page, so there is
# one URL per carrier. The built-in ones live in app/services/tracking.py and
# need nothing here. Set one of these only to correct a carrier that has
# changed its URL, or to add a carrier without a deploy. The middle word is
# the carrier's key in tracking.py; the last is bl, container or home.
# An empty value is ignored rather than removing the built-in link.
#
# Evergreen deliberately has NO deep link: both of the lines below were tried
# against a real Bill of Lading on 15 Sep 2026 and both landed on
# ShipmentLink's blank Quick Tracking form, so the button opens its search
# page and the portal shows the numbers to paste instead. If Evergreen ever
# offers a working GET link, uncommenting the right line is all it takes.
#CARRIER_URL_EVERGREEN_BL=https://www.shipmentlink.com/servlet/TDB1_CargoTracking.do?TYPE=BL&BL={bl}
#CARRIER_URL_EVERGREEN_CONTAINER=https://www.shipmentlink.com/servlet/TDB1_CargoTracking.do?TYPE=CT&CT={container}
#CARRIER_URL_EVERGREEN_HOME=https://www.shipmentlink.com/servlet/TDB1_CargoTracking.do

# ---- Live container tracking (ShipsGo) ----------------------------------
# The key from ShipsGo's dashboard (Integrations > API tokens). Server only:
# it never reaches a browser, and this file with a real value in it is never
# committed. Leave it blank and live tracking stays off everywhere.
#
# CREDITS: ShipsGo charges 1 credit to ADD a shipment; reading one is free.
# The portal adds a shipment only when staff press "Enable tracking" on it,
# at most once per B/L, and everything after that is a free read.
# Check the key first, read-only:  python -m scripts.shipsgo_check
SHIPSGO_API_KEY=

# How often every tracked shipment is read back from ShipsGo, in hours.
# Free. 0 turns the timer off (staff can still press Refresh).
SHIPSGO_REFRESH_EVERY_HOURS=6

# Move a tracked shipment's status forward by itself: loaded -> Shipped,
# sailing -> In transit, discharged at the destination port -> Delivered.
# Forward only; never out of Cancelled. On by default; false turns it off.
AUTO_STATUS_FROM_TRACKING=true

# ---- Notifications -------------------------------------------------------
# Master switch. Leave false until you are certain; nothing is emailed while
# it is off, but every message is still recorded and printed.
SEND_EMAILS=false

# During a pilot, ONLY these addresses receive the automatic shipment
# NOTIFICATIONS (comma separated). Leave blank to mail every customer.
# Adding an address later does not send it the updates it missed -- only
# what happens from then on (since 19 Sep 2026; see notifications.SETTLED).
#
# This does NOT apply to sign-in links. Somebody who asks to sign in is owed
# the email whoever they are, and until 16 Sep 2026 this list gated those too
# -- so a customer who was not on it was told to check their email and got
# nothing. SEND_EMAILS still stops everything, links included.
NOTIFY_ONLY_EMAILS=

# Which shipment statuses are worth telling a customer about.
NOTIFY_ON_STATUSES=Shipped,In transit,Delivered

# Which documents are worth telling a customer about when they first appear.
# Everything newly ready on one order goes in ONE email, however many
# documents and however many shipments it covers. A document that REPLACES
# one of the same kind says nothing: the customer was already told that kind
# was ready, and a second "it is ready" only asks which copy is right.
# Leave a type out to keep it silent; it is still uploaded and downloadable.
NOTIFY_ON_DOCUMENTS=Packing List,Commercial Invoice,Bill of Lading,Mill Test Certificate

# How often the portal sends whatever is waiting, by itself, in minutes.
# 0 switches the automatic sender off, and then the only ways anything goes
# out are the Send now button on the Messages screen and
# `python -m scripts.notify` on the server.
#
# This only decides WHEN sending is attempted. Whether real email leaves the
# building is still SEND_EMAILS and NOTIFY_ONLY_EMAILS above, so this being
# on does not by itself mail anybody.
NOTIFY_EVERY_MINUTES=15

# How long after the API starts before the first automatic run, in seconds.
# Not zero: a deploy restarts the container, and sending should not race the
# database coming back up.
NOTIFY_FIRST_RUN_DELAY_SECONDS=60

# Outgoing mail server
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=portal@alokindia.co.in

# Where the portal lives, used in the email link
PORTAL_URL=https://portal.alokindia.co.in

# The address the portal is served on, used by the web container.
#   portal.alokindia.co.in  -> Caddy gets and renews a real HTTPS certificate
#   :80                     -> plain HTTP, for testing on your own machine
PORTAL_DOMAIN=:80

# --- Sign-in rate limiting -------------------------------------------------
# Failed sign-ins are counted per (email, address), per address, and per
# account from any address. All are generous for a real person and mean to a
# script. Counts are held in memory and are lost when the API restarts,
# including on every deploy.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ADDRESS_MAX_ATTEMPTS=20
# Wrong passwords for one account from anywhere, per window. Past it the
# account's password sign-in waits out the lockout; its email link still works.
LOGIN_ACCOUNT_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_MAX_KEYS=10000

# --- Sign-in by email link -------------------------------------------------
# The link is PORTAL_URL + "/#sign-in=<token>", sent with the SMTP settings
# above. It obeys SEND_EMAILS -- while that is false, no sign-in link is
# delivered -- but NOT NOTIFY_ONLY_EMAILS: anybody with a login gets the link
# they asked for. A link that fails to send is logged as an ERROR and listed
# on the staff Messages screen, because the sign-in page cannot say so
# without telling a stranger which addresses have accounts.
#
# How long a sign-in link works, in seconds. 86400 is 24 hours.
#
# Raised from 900 (15 minutes) on 12 Sep 2026: a customer who read the email
# the next morning found a dead link. For as long as it lives the link is as
# good as a password and it is sitting in an inbox, so this is a real
# trade-off. Asking for a new link retires the old one, and a password change
# or reset kills any link already sent.
MAGIC_LINK_TTL_SECONDS=86400

# Whether a link stops working the moment it is used. true: it does.
#
# Email scanners cannot spend a link here, so single use costs nothing in
# reliability: the token sits after the "#" in the address, which no browser
# ever sends to a server, and signing in waits for a press of a button. The
# problem of a customer reading the email the next morning is solved by the
# 24 hours above, not by letting the link be replayed.
#
# Set it false only if a real scanner problem ever appears. No rebuild and no
# deploy needed -- set it, then:
#   docker compose -f docker-compose.prod.yml up -d --force-recreate api
MAGIC_LINK_SINGLE_USE=true
# Links per inbox, per window. Past this the answer is the same "check your
# email" and nothing more is sent.
MAGIC_LINK_MAX_PER_EMAIL=3
# Link requests per network address, per window, for any inboxes. Past this,
# the portal answers "too many" (HTTP 429).
MAGIC_LINK_MAX_PER_ADDRESS=10
MAGIC_LINK_WINDOW_SECONDS=900

# --- Signing in with a password --------------------------------------------
# true: the sign-in screen offers email + password as well as the emailed
# link, so nobody is locked out when email fails. Staff set a customer's
# password with Set password in the admin console; on the server,
# python -m scripts.set_password --email EMAIL sets anybody's.
# false: email link only, no password box (no rebuild needed either way).
# Recreate the api container after changing it.
PASSWORD_SIGN_IN=true

# Believe X-Forwarded-For. Correct here because the api service publishes no
# ports, so Caddy is the only thing that can reach it. Set false if the API
# is ever exposed directly.
TRUST_PROXY_HEADER=true
